2. Exemple de programme en Java avec Spring Boot

    a. Créer le contrôleur pour gérer l'interaction Discord

        Nous allons simuler une interaction via une commande slash (/rdv) où l'utilisateur fournit des informations comme le jeu et l'heure. Nous allons recevoir ces informations dans un contrôleur Spring Boot, les parser et les afficher.

        Fichier DiscordInteractionController.java

            java

            import org.springframework.web.bind.annotation.*;
            import java.util.List;
            import java.util.Map;

            @RestController
            @RequestMapping("/discord/interactions")
            public class DiscordInteractionController {

                @PostMapping
                public Map<String, Object> handleInteraction(@RequestBody Map<String, Object> interactionData) {
                    // Récupérer les informations de base
                    String interactionType = interactionData.get("type").toString();
                    Map<String, Object> userData = (Map<String, Object>) ((Map<String, Object>) interactionData.get("member")).get("user");

                    // Récupérer les informations de l'utilisateur
                    String userId = userData.get("id").toString();
                    String userName = userData.get("username").toString();
                    String userDiscriminator = userData.get("discriminator").toString();
                    String userAvatar = userData.get("avatar").toString();

                    // Récupérer les données de la commande
                    Map<String, Object> data = (Map<String, Object>) interactionData.get("data");
                    String commandName = data.get("name").toString();
                    List<Map<String, Object>> options = (List<Map<String, Object>>) data.get("options");

                    // Affichage des données collectées
                    System.out.println("Interaction Type: " + interactionType);
                    System.out.println("User ID: " + userId);
                    System.out.println("User Name: " + userName);
                    System.out.println("User Discriminator: " + userDiscriminator);
                    System.out.println("User Avatar: " + userAvatar);
                    System.out.println("Command: " + commandName);
                    System.out.println("Command Options:");
                    for (Map<String, Object> option : options) {
                        String optionName = option.get("name").toString();
                        String optionValue = option.get("value").toString();
                        System.out.println("- " + optionName + ": " + optionValue);
                    }

                    // Réponse de base pour valider l'interaction
                    return Map.of("type", 4, "data", Map.of("content", "Commande traitée avec succès !"));
                }
            }



